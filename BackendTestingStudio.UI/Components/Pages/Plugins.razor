@page "/plugins"
@using BackendTestingStudio.Core.Plugins
@inject IPluginWorkspace Workspace

<PageTitle>Plugins</PageTitle>

<section class="plugins-page">
    <header class="hero card">
        <div>
            <span class="eyebrow">Declarative contract 1.0</span>
            <h2>Plugin workspace</h2>
            <p>Abre un único plugin.json, valídalo y úsalo sin compilar código específico de la API.</p>
        </div>
        <div class="hero-metrics">
            <div class="metric"><span class="metric-label">Status</span><strong>@Status</strong></div>
            <div class="metric"><span class="metric-label">Schema</span><strong>1.0</strong></div>
        </div>
    </header>

    <section class="card panel">
        <div class="panel-header">
            <div><span class="eyebrow">Canonical source</span><h3>Open plugin.json</h3></div>
        </div>
        <label class="field">
            <span>Server-local file path</span>
            <input @bind="_path" placeholder="/absolute/path/plugin.json" />
        </label>
        <div class="actions">
            <button type="button" class="primary-button" @onclick="OpenAsync" disabled="@_busy">Open and validate</button>
            <button type="button" class="ghost-button" @onclick="ReloadAsync" disabled="@(_busy || Workspace.Active is null)">Reload</button>
        </div>
    </section>

    @if (Workspace.Active is { } load)
    {
        @if (load.Diagnostics.Count > 0)
        {
            <section class="card panel">
                <div class="panel-header"><h3>Diagnostics</h3><span class="count-pill">@load.Diagnostics.Count</span></div>
                <div class="header-list">
                    @foreach (var diagnostic in load.Diagnostics)
                    {
                        <div class="header-row">
                            <strong>@diagnostic.Severity · @diagnostic.JsonPath · @diagnostic.Rule</strong>
                            <span>@diagnostic.Message</span>
                        </div>
                    }
                </div>
            </section>
        }

        @if (load.IsValid && load.Plugin is { } plugin)
        {
            <article class="card panel plugin-card">
                <div class="panel-header">
                    <div><span class="eyebrow">@plugin.Id</span><h3>@plugin.Name</h3></div>
                    <span class="count-pill">v@plugin.Version</span>
                </div>
                <p>@plugin.Description</p>
                <div class="plugin-meta">
                    <div><span class="metric-label">Environments</span><strong>@plugin.Environments.Count</strong></div>
                    <div><span class="metric-label">Endpoints</span><strong>@plugin.Modules.Sum(item => item.Endpoints.Count)</strong></div>
                    <div><span class="metric-label">Scenarios</span><strong>@plugin.Scenarios.Count</strong></div>
                    <div><span class="metric-label">Assertions</span><strong>@plugin.Assertions.Count</strong></div>
                    <div><span class="metric-label">Payloads</span><strong>@plugin.Payloads.Count</strong></div>
                </div>

                @foreach (var module in plugin.Modules)
                {
                    <div class="section-block">
                        <h4>@module.Name</h4>
                        <div class="header-list">
                            @foreach (var endpoint in module.Endpoints)
                            {
                                <div class="header-row">
                                    <strong>@endpoint.Method @endpoint.Path</strong>
                                    <span>
                                        @endpoint.Name ·
                                        <NavLink href="@($"/api-explorer?pluginEndpoint={Uri.EscapeDataString(endpoint.Id)}")">Open in Explorer</NavLink>
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }
                <div class="actions">
                    <NavLink href="/scenarios" class="primary-button">Run scenarios</NavLink>
                </div>
            </article>
        }
    }
</section>

@code {
    private string _path = ResolveDefaultPluginPath();
    private bool _busy;
    private string Status => Workspace.Active is null ? "No plugin" : Workspace.Active.IsValid ? "Valid" : "Invalid";

    private async Task OpenAsync()
    {
        _busy = true;
        try { await Workspace.OpenAsync(_path); }
        finally { _busy = false; }
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        try { await Workspace.ReloadAsync(); }
        finally { _busy = false; }
    }

    private static string ResolveDefaultPluginPath()
    {
        var candidates = new[]
        {
            Path.Combine(Directory.GetCurrentDirectory(), "plugins", "dummyjson", "plugin.json"),
            Path.Combine(Directory.GetCurrentDirectory(), "..", "plugins", "dummyjson", "plugin.json")
        };
        return Path.GetFullPath(candidates.FirstOrDefault(File.Exists) ?? candidates[0]);
    }
}
